{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SauFox",
  "version": "0.1.5",
  "identifier": "ir.saufoxentertainment.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SauFox",
        "width": 1200,
        "height": 760,
        "minWidth": 980,
        "minHeight": 660,
        "resizable": true,
        "center": true,
        "decorations": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Farsi"]
      }
    }
  },
  "plugins": {}
}
